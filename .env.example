# NODE_ENV viene impostato automaticamente da build.sh (non modificare)

# ---------------------------------------------------------------------------
# Steam Web API (Step 2) — OPZIONALE
# STEAM_API_KEY: https://steamcommunity.com/dev/apikey
# STEAM_ID: il tuo SteamID64 (rilevato automaticamente se vuoto)
# ---------------------------------------------------------------------------
STEAM_API_KEY=
STEAM_ID=

# ---------------------------------------------------------------------------
# Classic Console / ROM (Step 3) — OPZIONALE
# Cartella dove cercare le ROM. Default: ~/Roms/
# Struttura attesa: ~/Roms/SNES/, ~/Roms/NES/, ~/Roms/N64/ ecc.
# Sono supportati solo file .zip
# ---------------------------------------------------------------------------
ROMS_PATH=~/Roms/

# --- Step 9: Metadata API ---
# SteamGridDB: cover art per GOG, Epic, Classic Console
# Ottieni la chiave su https://www.steamgriddb.com/profile/preferences/api
STEAMGRIDDB_API_KEY=

# IGDB: rating, generi, descrizione, data uscita
# Registra un'app su https://dev.twitch.tv/console per ottenere Client ID e Secret
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# --- v3.2.17-dev.8: Amazon Luna (card fissa del plugin Amazon Games) ---
# Browser per i servizi in streaming (runner "Web Stream"). Vuoto = il primo trovato
# fra chromium, google-chrome-stable, google-chrome.
# X_LAUNCHER_WEB_BROWSER=chromium
# Pagina di Luna usata al primo inserimento della card (poi modificabile dalla card).
# X_LAUNCHER_LUNA_URL=https://luna.amazon.it/?g=s

# --- v3.2.29-dev.3: screenshot dei giochi (Select + D-pad su, sessione Openbox) ---
# Qualità JPEG degli screenshot archiviati in ~/.local/share/x-launcher/multimedia/ (1-100).
# X_LAUNCHER_SCREENSHOT_QUALITY=85

# --- v3.2.29-dev.6/7: clip dei giochi ---
# ATTENZIONE: X_LAUNCHER_SHARE_HOLD_S (pressione di Share per le clip, 0.4-3 s, default 1) e
# X_LAUNCHER_CLIP_MAX_S (durata massima di una clip, default 120) NON vanno qui: questo file lo legge
# solo il demone, mentre li usa spaces.py nella sessione Openbox. Vanno in ~/.config/openbox/environment,
# per esempio:  export X_LAUNCHER_SHARE_HOLD_S=2   (poi nuovo login).

# --- v3.2.29-dev.11: condivisione su YouTube dalla sezione Multimedia ---
# Client OAuth personale su Google Cloud, tipo «TV e dispositivi con input limitato», con la
# YouTube Data API v3 abilitata e la schermata di consenso pubblicata («In production»: in «Testing»
# l'accesso scade dopo 7 giorni). Guida passo passo in INSTALL.md, «Condivisione su YouTube».
# X_LAUNCHER_YOUTUBE_CLIENT_ID=
# X_LAUNCHER_YOUTUBE_CLIENT_SECRET=

# --- v3.2.29-dev.17: sfondo degli spazi dei giochi (sessione Openbox) ---
# Usa le stesse chiavi dei metadati: IGDB_CLIENT_ID/IGDB_CLIENT_SECRET (artwork 16:9) e
# STEAMGRIDDB_API_KEY (hero ad alta risoluzione, in mancanza). Per disattivarlo:
# export X_LAUNCHER_SPACE_BG=0 in ~/.config/openbox/environment (lo legge spaces.py, non il demone).
