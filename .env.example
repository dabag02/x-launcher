# NODE_ENV viene impostato automaticamente da build.sh (non modificare)

# ---------------------------------------------------------------------------
# Steam Web API (Step 2) — OPZIONALE
# STEAM_API_KEY: https://steamcommunity.com/dev/apikey
# STEAM_ID: il tuo SteamID64 (rilevato automaticamente se vuoto)
# ---------------------------------------------------------------------------
STEAM_API_KEY=
STEAM_ID=

# ---------------------------------------------------------------------------
# Classic Console / ROM (Step 3) — OPZIONALE
# Cartella dove cercare le ROM. Default: ~/Roms/
# Struttura attesa: ~/Roms/SNES/, ~/Roms/NES/, ~/Roms/N64/ ecc.
# Sono supportati solo file .zip
# ---------------------------------------------------------------------------
ROMS_PATH=

# --- Step 9: Metadata API ---
# SteamGridDB: cover art per GOG, Epic, Classic Console
# Ottieni la chiave su https://www.steamgriddb.com/profile/preferences/api
STEAMGRIDDB_API_KEY=

# IGDB: rating, generi, descrizione, data uscita
# Registra un'app su https://dev.twitch.tv/console per ottenere Client ID e Secret
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
