{
  "name": "x-launcher",
  "private": true,
  "version": "1.1.125-dev.1",
  "type": "module",
  "scripts": {
    "dev": "bash scripts/with-env.sh tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "NODE_ENV=production bash scripts/with-env.sh node dist/server.cjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.6",
    "better-sqlite3": "^11.10.0",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.0",
    "express": "^5.2.1",
    "i18next": "^26.3.6",
    "i18next-http-backend": "^4.0.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-i18next": "^17.0.9",
    "tailwind-merge": "^2.5.4",
    "tsx": "^4.21.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.4.47",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
